[126.8443, "o", "y the last message (resend to agent)\u001b[62C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[39m \u001b[38;5;179m\u001b[1m /undo\u001b[22m\u001b[39m     \u001b[38;5;250mBack up N user turns and re-prompt (default 1) (usage: /undo [N])\u001b[37C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[39m \u001b[38;5;179m\u001b[1m /title\u001b[22m\u001b[39m    \u001b[38;5;250mSet a title for the current session (usage: /title [name])\u001b[44C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /branch\u001b[3C\u001b[22m\u001b[38;5;250mBranch the current session (new thread on Discord/Telegram/Slack/Matrix; --here stays here) (usage: \u001b[2C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[39m \u001b[1C          \u001b[38;5;250m/branch [--here] [name])\u001b[39m                                                                            \u001b[2C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /fork\u001b[22m\u001b[39m     \u001b[38;5;250mBranch the current session (new thread on Discord/Telegram/Slack/Matrix; --here stays here) (alias \u001b[3C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[12C\u001b[38;5;250mfor /branch)\u001b[90C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /compress\u001b[22m\u001b[39m \u001b[38;5;250mCompress conversation context (ad"]
[126.8452, "o", "d 'here [N]' to keep recent N turns; --preview shows what would \u001b[5C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[2C\u001b[39m          \u001b[38;5;250mhappen) (usage: /compress [here [N] | focus topic | --preview|--dry-run])\u001b[39m \u001b[28C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /compact\u001b[22m\u001b[39m  \u001b[38;5;250mCompress conversation context (add 'here [N]' to keep recent N turns; --preview shows what would \u001b[5C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[2C\u001b[39m          \u001b[38;5;250mhappen) (alias for /compress)\u001b[39m                      \u001b[51C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /rollback\u001b[22m\u001b[39m \u001b[38;5;250mList or restore filesystem checkpoints (restores keep your hand-edits; --all overrides) (usage: \u001b[6C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[2C\u001b[39m          \u001b[38;5;250m/rollback [number] [--all])\u001b[39m                                                                      \u001b[5C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /stop\u001b[22m\u001b[39m     \u001b[38;5;250mKill all running background processes\u001b[39m                                                               "]
[126.8461, "o", "\u001b[2C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /bg\u001b[22m\u001b[39m       \u001b[38;5;250mRun a prompt in a separate background session (usage: /bg <prompt>)\u001b[39m                   \u001b[16C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /btw\u001b[22m\u001b[39m      \u001b[38;5;250mAsk a side question about the current conversation without interrupting it (usage: /btw <question>)\u001b[3C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /agents\u001b[3C\u001b[22m\u001b[38;5;250mShow active agents and running tasks\u001b[66C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u2551\u001b[1C\u001b[38;5;179m\u001b[1m /tasks\u001b[4C\u001b[22m\u001b[38;5;250mShow active agents and running tasks (alias for /agents)\u001b[46C\u001b[38;5;220m\u2551\r\u001b[1C\u001b[1B\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\u001b[39m\u001b[48;1H\u001b[48;5H\u001b]1;\u2713 No Cap demo\u0007\u001b]2;\u2713 No"]
