[51.1241, "o", "\u001b[?2004h\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0;38;5;102m\u2500\u2500 \u001b[0;38;5;214;1m\u280f \u001b[0m\ud83d\udcbb pytest -q\u001b[0;38;5;101m \u00b7 24s \u00b7 \u2193 161 tok\u001b[0;38;5;102m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0;38;5;178mThe login tests in this repo fail. Run pytest\u2026\u001b[0;38;5;102m \r\u001b[117C\u2500\u001b[0m\r\r\n\u001b[0;38;5;136;3m\u2624 \u276f type to redirect this turn \u00b7 Tab queues it for after\u001b[0m\r\r\n\u001b[0;38;5;102m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[117C\u2500\u001b[0m\r\r\n\u001b[0;38;5;250m \u2624 \u001b[0;38;5;220;1mqwen3-4b-instruct-2507-...\u001b[0;38;5;101m \u00b7 14.9K/65.5K pinned \u00b7 \u001b[0;38;5;108;1m[\u2588\u2588\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591]\u001b[0;38;5;101m \u001b[0;38;5;108;1m23%\u001b[0;38;5;101m \u00b7 \u001b[0;38;5;108;1m\u25ce 72.0%\u001b[0;38;5;101m "]
