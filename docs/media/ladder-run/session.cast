[65.0944, "o", "\u001b[?25l\u001b[?7l\u001b[0m/\u001b[0;38;5;241mq\u001b[0m\u001b[K\u001b[0m\r\r\n\r\r\n\u001b[0;38;5;230;48;5;234m /new           \u001b[0;38;5;136;48;5;234m Start a new session (fresh session ID + history) (usage: /new [name])                               \r\u001b[117C\u001b[0;38;5;230;48;5;238m \u001b[0m\r\r\n\u001b[0;38;5;230;48;5;234m /reset         \u001b[0;38;5;136;48;5;234m Start a new session (fresh session ID + history) (alias for /new)                                   \r\u001b[117C\u001b[0;38;5;230;48;5;238m \u001b[0m\r\r\n\u001b[0;38;5;230;48;5;234m /clear         \u001b[0;38;5;136;48;5;234m Clear screen and start a new session                                                                \r\u001b[117C\u001b[0;38;5;230;48;5;248m \u001b[0m\r\r\n\u001b[0;38;5;230;48;5;234m /redraw        \u001b[0;38;5;136;48;5;234m Force a full UI repaint (recovers from terminal drift)                                              \r\u001b[117C\u001b[0;38;5;230;48;5;248m \u001b[0m\r\r\n\u001b[0;38;5;230;48;5;234m /history       \u001b[0;38;5;136;48;5;234m Show conversation history                                                                           \r\u001b[117C\u001b[0;38;5;230;48;5"]
