[52.9646, "o", "\u001b[?2004l\u001b[0 q\u001b[0m\u001b[?7h\u001b[0m\ud83e\ude7a **No Cap doctor**\r\r\n\u2705 No other plugin rewrites replies (transform_llm_output).\r\r\n\u2705 Mode: strict (pre_verify nudges coding turns, at most 2 per turn) \u00b7 show_uncertain: strict\r\r\n\u2139\ufe0f /cap can only send its steer itself where Hermes runs plugins inside a local CLI. Gateway-backed sessions (Discord, Telegram, TUI, Desktop, and the classic CLI on Hermes builds that route it through the local gateway) need plugins.entries.no-cap.allow_gateway_injection: true. Until then /cap prints the steer for you to paste.\r\r\n\u2705 Store writable: /private/tmp/nocap-demo.kxqoBh/home/plugin-data/agent-plugin-no-cap-4890e304/receipts.jsonl\r\r\n\u2139\ufe0f 3 checked replies, platforms seen: cli\r\r\n\u2705 Network: none\r\r\n0 problems found.\r\r\n\u001b[0m"]
[52.9658, "o", "\u001b[?2004h\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0;38;5;102m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0;38;5;178mNo Cap demo\u001b[0;38;5;102m \r\u001b[117C\u2500\u001b[0m\r\r\n\u001b[0;38;5;230m\u276f \u001b[0;38;5;136;3mType / to browse commands, or Ctrl+P for the palette\u001b[0m\r\r\n\u001b[0;38;5;102m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[117C\u2500\u001b[0m\r\r\n\u001b[0;38;5;250m \u2624 \u001b[0;38;5;220;1mover-eager-1\u001b[0;38;5;101m \u00b7 ~468/128K \u00b7 \u001b[0;38;5;108;1m[\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591]\u001b[0;38;5;101m \u001b[0;3"]
